---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { businessInfo } from '../data/services';

const title = 'Contact Us | Request a Free Quote | NextDoor Handyman Long Island';
const description = 'Contact NextDoor Handyman Long Island for a free quote on your home repair or improvement project. Serving all of Suffolk County, NY. Call (631) 295-4020.';
---

<BaseLayout title={title} description={description} canonicalUrl="/contact">
  <Hero
    title="Contact Us"
    subtitle="Ready to get started on your project? Reach out for a free, no-obligation quote. We're here to help!"
    showCta={false}
    backgroundImage="/hero-bg.png"
  />

  <!-- Contact Section -->
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12">
        <!-- Contact Info -->
        <div>
          <h2 class="text-3xl font-bold text-dark mb-8">
            Get In Touch
          </h2>

          <div class="space-y-6 mb-10">
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-dark mb-1">Phone</h3>
                <a href={businessInfo.phoneLink} class="text-primary hover:text-primary-dark text-lg font-medium transition-colors">
                  {businessInfo.phone}
                </a>
                <p class="text-gray-600 text-sm mt-1">Call or text us anytime</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-dark mb-1">Email</h3>
                <a href={`mailto:${businessInfo.email}`} class="text-primary hover:text-primary-dark font-medium transition-colors">
                  {businessInfo.email}
                </a>
                <p class="text-gray-600 text-sm mt-1">We'll respond ASAP</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-dark mb-1">Service Area</h3>
                <p class="text-gray-700">All of Suffolk County, NY</p>
                <p class="text-gray-600 text-sm mt-1">Based in Yaphank</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-dark mb-1">Business Hours</h3>
                <p class="text-gray-700">{businessInfo.hours}</p>
                <p class="text-gray-600 text-sm mt-1">7 days a week</p>
              </div>
            </div>
          </div>

          <!-- What to Expect -->
          <div class="bg-gray-50 rounded-xl p-6">
            <h3 class="text-lg font-semibold text-dark mb-4">What to Expect</h3>
            <ol class="space-y-4">
              <li class="flex gap-4">
                <div class="flex-shrink-0 w-8 h-8 bg-primary text-white rounded-full flex items-center justify-center font-semibold text-sm">
                  1
                </div>
                <div>
                  <p class="font-medium text-dark">Submit Your Request</p>
                  <p class="text-gray-600 text-sm">Fill out the form or give us a call</p>
                </div>
              </li>
              <li class="flex gap-4">
                <div class="flex-shrink-0 w-8 h-8 bg-primary text-white rounded-full flex items-center justify-center font-semibold text-sm">
                  2
                </div>
                <div>
                  <p class="font-medium text-dark">We'll Contact You</p>
                  <p class="text-gray-600 text-sm">ASAP to discuss your project</p>
                </div>
              </li>
              <li class="flex gap-4">
                <div class="flex-shrink-0 w-8 h-8 bg-primary text-white rounded-full flex items-center justify-center font-semibold text-sm">
                  3
                </div>
                <div>
                  <p class="font-medium text-dark">Free Estimate</p>
                  <p class="text-gray-600 text-sm">We'll provide a detailed, no-obligation quote</p>
                </div>
              </li>
              <li class="flex gap-4">
                <div class="flex-shrink-0 w-8 h-8 bg-primary text-white rounded-full flex items-center justify-center font-semibold text-sm">
                  4
                </div>
                <div>
                  <p class="font-medium text-dark">Schedule & Complete</p>
                  <p class="text-gray-600 text-sm">We schedule at your convenience and get the job done right</p>
                </div>
              </li>
            </ol>
          </div>
        </div>

        <!-- Quote Form -->
        <div>
          <div class="bg-white rounded-2xl p-8 shadow-lg border border-gray-100">
            <h2 class="text-2xl font-bold text-dark mb-2">
              Request a Free Quote
            </h2>
            <p class="text-gray-600 mb-6">
              Fill out the form below and we'll get back to you as soon as possible.
            </p>

            <QuoteForm />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Map Section -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-dark mb-4">
          Our Service Area
        </h2>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
          We proudly serve homeowners throughout Suffolk County, NY. If you're on Long Island's East End, we're here to help!
        </p>
      </div>

      <div class="rounded-2xl overflow-hidden shadow-lg">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d12080.953387168158!2d-73.14676154999998!3d40.8007559!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x87954711b78cc2b%3A0xc7b2223bccc70b34!2sNextDoor%20Handyman%20Long%20Island!5e0!3m2!1sen!2sus!4v1769553410743!5m2!1sen!2sus"
          width="100%"
          height="450"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="NextDoor Handyman Long Island - Google Maps"
        ></iframe>
      </div>
    </div>
  </section>
</BaseLayout>
