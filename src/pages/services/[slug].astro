---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceSchema from '../../components/ServiceSchema.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { services, businessInfo, suffolkTowns } from '../../data/services';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
};

const { service } = Astro.props;

// Get related services (exclude current service, take 3)
const relatedServices = services
  .filter((s) => s.slug !== service.slug)
  .slice(0, 3);

const iconPaths: Record<string, string> = {
  wrench: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z',
  droplet: 'M12 22c4.97 0 9-4.03 9-9 0-4.418-9-13-9-13S3 8.582 3 13c0 4.97 4.03 9 9 9z',
  zap: 'M13 2L3 14h9l-1 8 10-12h-9l1-8z',
  hammer: 'M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z',
  paintbrush: 'M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z',
  square: 'M4 5a1 1 0 011-1h14a1 1 0 011 1v14a1 1 0 01-1 1H5a1 1 0 01-1-1V5z',
  armchair: 'M5 12V7a5 5 0 0110 0v5M5 12H3v4a2 2 0 002 2h14a2 2 0 002-2v-4h-2M5 12h14',
  briefcase: 'M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
  sparkles: 'M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z',
  home: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6',
  tv: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z'
};

const iconPath = iconPaths[service.icon] || iconPaths.wrench;
---

<BaseLayout
  title={service.metaTitle}
  description={service.metaDescription}
  canonicalUrl={`/services/${service.slug}`}
>
  <ServiceSchema service={service} />

  <!-- Breadcrumb -->
  <nav class="bg-gray-50 py-3">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ol class="flex items-center gap-2 text-sm">
        <li>
          <a href="/" class="text-gray-500 hover:text-primary transition-colors">Home</a>
        </li>
        <li class="text-gray-400">/</li>
        <li>
          <a href="/services" class="text-gray-500 hover:text-primary transition-colors">Services</a>
        </li>
        <li class="text-gray-400">/</li>
        <li class="text-primary font-medium">{service.name}</li>
      </ol>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-primary to-primary-dark text-white py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <div class="inline-flex items-center justify-center w-16 h-16 bg-white/10 rounded-xl mb-6">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={iconPath} />
            </svg>
          </div>

          <h1 class="text-4xl md:text-5xl font-bold leading-tight mb-6">
            {service.name} in Suffolk County, NY
          </h1>

          <p class="text-xl text-gray-200 mb-8 leading-relaxed">
            {service.description}
          </p>

          <div class="flex flex-col sm:flex-row gap-4">
            <a
              href="#quote-form"
              class="inline-flex items-center justify-center bg-accent hover:bg-accent-hover text-white font-semibold px-8 py-4 rounded-lg text-lg transition-colors"
            >
              Get a Free Quote
              <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
            <a
              href="tel:+16312954020"
              class="inline-flex items-center justify-center bg-white/10 hover:bg-white/20 text-white font-semibold px-8 py-4 rounded-lg text-lg transition-colors border border-white/20"
            >
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              {businessInfo.phone}
            </a>
          </div>
        </div>

        <div class="hidden lg:block">
          <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-8 border border-white/20">
            <h3 class="text-xl font-semibold mb-4">Our {service.name} Include:</h3>
            <ul class="space-y-3">
              {service.features.slice(0, 6).map((feature) => (
                <li class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-accent flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span class="text-gray-200">{feature}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Included -->
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12">
        <div>
          <h2 class="text-3xl font-bold text-dark mb-6">
            What's Included in Our {service.name}
          </h2>
          <p class="text-lg text-gray-600 mb-8">
            We provide comprehensive {service.name.toLowerCase()} to address all your needs. Our skilled technicians are equipped to handle:
          </p>

          <ul class="grid sm:grid-cols-2 gap-4">
            {service.features.map((feature) => (
              <li class="flex items-start gap-3 bg-gray-50 p-4 rounded-lg">
                <svg class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-gray-700">{feature}</span>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <h2 class="text-3xl font-bold text-dark mb-6">
            Why Choose Us for {service.name}
          </h2>

          <div class="space-y-6">
            <div class="flex gap-4">
              <div class="flex-shrink-0 w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-dark mb-1">Experienced Professionals</h3>
                <p class="text-gray-600">Our technicians have years of experience in {service.name.toLowerCase()}.</p>
              </div>
            </div>

            <div class="flex gap-4">
              <div class="flex-shrink-0 w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-dark mb-1">Fair, Transparent Pricing</h3>
                <p class="text-gray-600">Get a detailed quote upfront with no hidden fees or surprises.</p>
              </div>
            </div>

            <div class="flex gap-4">
              <div class="flex-shrink-0 w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-dark mb-1">Satisfaction Guaranteed</h3>
                <p class="text-gray-600">We stand behind our work with a 100% satisfaction guarantee.</p>
              </div>
            </div>

            <div class="flex gap-4">
              <div class="flex-shrink-0 w-12 h-12 bg-primary/10 rounded-lg flex items-center justify-center">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-dark mb-1">Local to Suffolk County</h3>
                <p class="text-gray-600">Based in Yaphank, we're your neighbors serving the local community.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  {service.faqs.length > 0 && (
    <section class="py-16 bg-gray-50">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-dark text-center mb-12">
          Frequently Asked Questions About {service.name}
        </h2>

        <div class="space-y-6">
          {service.faqs.map((faq, index) => (
            <div class="bg-white rounded-xl p-6 shadow-sm">
              <h3 class="text-lg font-semibold text-dark mb-3">
                {faq.question}
              </h3>
              <p class="text-gray-600 leading-relaxed">
                {faq.answer}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Service Area -->
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8">
        <h2 class="text-3xl font-bold text-dark mb-4">
          {service.name} Throughout Suffolk County
        </h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          We proudly provide {service.name.toLowerCase()} to homeowners in all Suffolk County communities.
        </p>
      </div>

      <div class="flex flex-wrap justify-center gap-2 mb-8">
        {suffolkTowns.map((town) => (
          <span class="bg-gray-100 text-gray-700 px-3 py-1 rounded-full text-sm">
            {town}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- Quote Form Section -->
  <section id="quote-form" class="py-16 bg-primary">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-2xl p-8 md:p-12 shadow-xl">
        <div class="text-center mb-8">
          <h2 class="text-3xl font-bold text-dark mb-4">
            Request a Free {service.name} Quote
          </h2>
          <p class="text-lg text-gray-600">
            Fill out the form below and we'll get back to you within 24 hours with a free estimate.
          </p>
        </div>

        <QuoteForm preselectedService={service.slug} />
      </div>
    </div>
  </section>

  <!-- Related Services -->
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-dark text-center mb-12">
        Other Services You May Need
      </h2>

      <div class="grid md:grid-cols-3 gap-6">
        {relatedServices.map((relatedService) => (
          <ServiceCard
            slug={relatedService.slug}
            name={relatedService.name}
            description={relatedService.shortDescription}
            icon={relatedService.icon}
          />
        ))}
      </div>

      <div class="text-center mt-8">
        <a
          href="/services"
          class="inline-flex items-center text-primary font-semibold hover:text-primary-dark transition-colors"
        >
          View All Services
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
